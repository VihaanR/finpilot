      {
        "parameters": {
          "method": "GET",
          "url": "https://finpilot-w4ki.onrender.com/api/radar",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "options": {}
        },
        "id": "fb529639-7082-452f-9959-ce52536e7ee1",
        "name": "GET /api/radar",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          440,
          0
        ],
        "credentials": {
          "httpHeaderAuth": {
            "id": "finpilot-api-cred",
            "name": "FinPilot API"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "const dash = $('GET /api/dashboard').first().json;\nconst radar = $json;\nconst sts = dash.safe_to_spend || {};\nconst dueToday = (radar.banner?.items || []).filter(i => i.days_away <= 1);\nlet text = 'Good morning. Safe to spend: ₹' + Math.round((sts.safe_daily_paise||0)/100)\n  + '/day. Discretionary left this month: ₹' + Math.round((sts.discretionary_paise||0)/100) + '.';\nif (dueToday.length) {\n  text += '\\nDue today: ' + dueToday.map(i => i.merchant + ' ₹' + Math.round(i.amount_paise/100)).join(', ') + '.';\n}\nreturn [{ json: { text } }];"
        },
        "id": "486a2199-859a-46b0-9f56-f7bd08f3ba7a",
        "name": "Compose brief",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          660,
          0
        ]
      },
      {
        "parameters": {
          "resource": "message",
          "operation": "sendMessage",
          "chatId": "REPLACE_WITH_YOUR_TELEGRAM_CHAT_ID",
          "text": "={{ $json.text }}",
          "additionalFields": {
            "parse_mode": "Markdown"
          }
        },
        "id": "9f5431b6-01da-49e0-8826-b16d46c05261",
        "name": "Send daily brief",
        "type": "n8n-nodes-base.telegram",
        "typeVersion": 1.2,
        "position": [
          880,
          0
        ],
        "credentials": {
          "telegramApi": {
            "id": "telegram-bot-cred",
            "name": "Telegram Bot"
          }
        }
      }
    ],
    "connections": {
      "Daily 08:00 IST": {
        "main": [
          [
            {
              "node": "GET /api/dashboard",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "GET /api/dashboard": {
