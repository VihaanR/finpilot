# FinPilot API environment.
# Copy to services/api/.env and fill in. Never commit the filled-in file.
# Every value below is intentionally empty (BUILD_TASKS.md T01 criterion 4).

# --- Groq (chat + monthly summary; USER.md section 1) -----------------------
# console.groq.com/keys -> Create API key. Free tier, no card needed.
GROQ_API_KEY=
# Model IDs, overridable without a code change. Defaults in app/config.py.
GROQ_MODEL_CHAT=openai/gpt-oss-20b
GROQ_MODEL_SUMMARY=openai/gpt-oss-20b

# --- Google Gemini (bulk categorisation, PDF fallback, embeddings) ----------
# aistudio.google.com/apikey -> Create API key. Free tier, no card needed.
# NOTE: a consumer Google AI Plus/Pro/Ultra subscription does NOT raise API
# rate limits; API quota is per Cloud project and needs billing for Tier 1.
GEMINI_API_KEY=
GEMINI_MODEL_CLASSIFY=gemini-3.5-flash-lite
GEMINI_MODEL_EMBEDDING=gemini-embedding-2
# Must match document_chunks.embedding in supabase/migrations/.
EMBEDDING_DIMENSIONS=768

# --- Supabase (USER.md section 2) -------------------------------------------
# Project URL, from Settings -> API.
SUPABASE_URL=
# service_role secret. Bypasses row-level security: server only, never the
# browser, never a NEXT_PUBLIC_* name, never the extension.
SUPABASE_SERVICE_KEY=
# anon public key, used only for auth token verification on this service.
SUPABASE_ANON_KEY=
# Postgres connection string; password is the one set at project creation.
DATABASE_URL=

# --- CORS -------------------------------------------------------------------
# Comma-separated browser origins allowed to call this API. Add the Vercel URL
# at T12 or the deployed front end will fail CORS preflight.
ALLOWED_ORIGINS=http://localhost:3000

# --- Integrations -----------------------------------------------------------
# Telegram bot token from @BotFather (USER.md section 5), needed at T14.
TELEGRAM_BOT_TOKEN=
# Shared bearer token n8n and the extension use to call this API.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=

# --- Gmail-connected ingestion (optional, Data Vault "Connect Gmail" panel) --
# console.cloud.google.com -> APIs & Services -> Credentials -> Create
# credentials -> OAuth client ID -> Web application. Enable the Gmail API on
# the same project first. Add GOOGLE_OAUTH_REDIRECT_URI below as an
# authorized redirect URI on the client, and (while the consent screen is in
# "Testing" mode) add your own Google account as a test user.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8001/api/email/callback

# --- Bhashini (optional, USER.md section 9) ---------------------------------
# Vernacular summary translation. The demo works without these via the
# browser-native Web Speech API.
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# --- Behaviour --------------------------------------------------------------
# DPDP retention window; documents are purged this many days after upload.
RETENTION_DAYS=90
# Upload size cap in megabytes.
MAX_UPLOAD_MB=20
