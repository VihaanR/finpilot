# FinPilot API environment.
# Copy to services/api/.env and fill in. Never commit the filled-in file.
# Every value below is intentionally empty (BUILD_TASKS.md T01 criterion 4).

# --- Anthropic (USER.md section 1) ------------------------------------------
# Console -> Settings -> API Keys. Add $10-20 of credit; an empty balance
# produces confusing 400-level errors mid-build.
ANTHROPIC_API_KEY=

# --- Supabase (USER.md section 2) -------------------------------------------
# Project URL, from Settings -> API.
SUPABASE_URL=
# service_role secret. Bypasses row-level security: server only, never the
# browser, never a NEXT_PUBLIC_* name, never the extension.
SUPABASE_SERVICE_KEY=
# anon public key, used only for auth token verification on this service.
SUPABASE_ANON_KEY=
# Postgres connection string; password is the one set at project creation.
DATABASE_URL=

# --- CORS -------------------------------------------------------------------
# Comma-separated browser origins allowed to call this API. Add the Vercel URL
# at T12 or the deployed front end will fail CORS preflight.
ALLOWED_ORIGINS=http://localhost:3000

# --- Integrations -----------------------------------------------------------
# Telegram bot token from @BotFather (USER.md section 5), needed at T14.
TELEGRAM_BOT_TOKEN=
# Shared bearer token n8n and the extension use to call this API.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=

# --- Bhashini (optional, USER.md section 9) ---------------------------------
# Vernacular summary translation. The demo works without these via the
# browser-native Web Speech API.
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# --- Behaviour --------------------------------------------------------------
# DPDP retention window; documents are purged this many days after upload.
RETENTION_DAYS=90
# Upload size cap in megabytes.
MAX_UPLOAD_MB=20
